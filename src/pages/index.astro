---
import ProductCard from "../components/ProductCard.astro";
import OrderCounter from "../components/OrderCounter.jsx"

const products = [
	{
		name: "Espresso",
		description: "Café intenso y aromático",
		price: 1.8
	},
	{
		name: "Capuchino",
		description: "Café, leche y espuma",
		price: 3.2
	},
	{
		name: "Tarta de queso",
		description: "Tarta casera con frutos rojos",
		price: 4.5
	}
]
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body>
		<h1>Astro</h1>
		<h2>Menú</h2>
		<section>
			{
				products.map((product) => (
					<ProductCard
					name={product.name}
					description={product.description}
					price={product.price}
					/>
				))
			}
		</section>

		<section>
			<h2>Tu pedido</h2>
			<OrderCounter client:media="(max-width: 768px)" />
		</section>
	</body>
</html>
